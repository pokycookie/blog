---
import { getCollection } from 'astro:content'

import { Frontmatter } from '@/components/frontmatter'
import RootLayout from '@/layout/root-layout.astro'
import { PostBreadcrumb } from '@/components/post-breadcrumb'

export async function getStaticPaths() {
  const posts = await getCollection('posts')

  return posts.map((post) => ({
    params: { id: post.data.id.toString() },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()
---

<RootLayout>
  <main class="flex flex-col items-center px-4 py-8">
    <section class="flex flex-col gap-4 mb-8 w-full max-w-xl">
      <h1 class="text-3xl font-black">{post.data.title}</h1>
      <PostBreadcrumb slug={post.slug} />
      <Frontmatter {...post.data} />
    </section>
    <article class="prose prose-sm">
      <Content />
    </article>
  </main>
</RootLayout>
